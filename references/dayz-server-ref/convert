python3 -c "
import os, glob
from bs4 import BeautifulSoup

source_dir = '/home/sysadmin/Documents/git/DayzServerTools/dayz-server-ref/dayzexplorer.zeroy.com/'
output_file = '/home/sysadmin/Documents/git/DayzServerTools/dayz-server-ref/dayz_ai_reference2.txt'

with open(output_file, 'w', encoding='utf-8') as outfile:
    # Recursively find all HTML files
    for filepath in glob.glob(os.path.join(source_dir, '**/*.html'), recursive=True):
        with open(filepath, 'r', encoding='utf-8') as f:
            soup = BeautifulSoup(f.read(), 'html.parser')
            
            # ReadTheDocs stores the core content inside the 'main' role div
            main_content = soup.find('div', {'role': 'main'})
            if not main_content:
                main_content = soup.body
                
            if main_content:
                # Add a clear boundary header so the AI knows the source file origin
                rel_path = os.path.relpath(filepath, source_dir)
                outfile.write(f'\n\n=== DOCUMENT SECTION: {rel_path} ===\n\n')
                
                # Extract clean text
                text = main_content.get_text(separator='\n', strip=True)
                outfile.write(text)

print(f'Success! Machine-readable file created at: {output_file}')
"
